{
  "name": "n8n-nodes-warmy-io",
  "version": "0.1.2",
  "description": "n8n community node for Warmy.io email warmup API",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "warmy",
    "email-warmup"
  ],
  "license": "MIT",
  "homepage": "https://github.com/skachkiss/n8n-nodes-warmy-io#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skachkiss/n8n-nodes-warmy-io.git"
  },
  "bugs": {
    "url": "https://github.com/skachkiss/n8n-nodes-warmy-io/issues"
  },
  "author": {
    "name": "skachkiss"
  },
  "main": "index.js",
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/WarmyApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Warmy/Warmy.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "jsonc-eslint-parser": "^3.1.0",
    "n8n-workflow": "^1.82.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.2"
  }
}
